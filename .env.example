# ============================================================
# FINTECH FRAUDE/SCORING - ENV EXAMPLE
# Copy to .env and adjust values if needed. Never commit .env.
# ============================================================

# --- Images ---
POSTGRES_IMAGE=postgres:15-alpine
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v24.3.11
REDPANDA_CONSOLE_IMAGE=docker.redpanda.com/redpandadata/console:v3.9.0
DEBEZIUM_IMAGE=debezium/connect:3.0.0.Final
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
METABASE_IMAGE=metabase/metabase:v0.52.5

# --- Network / Host ports ---
POSTGRES_OLTP_PORT=5432
POSTGRES_OLAP_PORT=5433
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDPANDA_SCHEMA_PORT=8081
REDPANDA_CONSOLE_PORT=8080
DEBEZIUM_PORT=8083
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
METABASE_PORT=3000

# --- PostgreSQL OLTP (source) ---
POSTGRES_OLTP_DB=fintech_oltp
POSTGRES_OLTP_USER=oltp_user
POSTGRES_OLTP_PASSWORD=oltp_password

# --- PostgreSQL OLAP (warehouse for dbt / Metabase) ---
POSTGRES_OLAP_DB=fintech_olap
POSTGRES_OLAP_USER=olap_user
POSTGRES_OLAP_PASSWORD=olap_password

# --- MinIO / Lakehouse ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=fintech-lakehouse

# --- Debezium (Kafka Connect) ---
DEBEZIUM_GROUP_ID=connect-cluster
DEBEZIUM_CONFIG_STORAGE_TOPIC=connect-configs
DEBEZIUM_OFFSET_STORAGE_TOPIC=connect-offsets
DEBEZIUM_STATUS_STORAGE_TOPIC=connect-status

# --- JVM memory limits (services Java: deben ahorrar RAM en dev) ---
DEBEZIUM_HEAP_OPTS=-Xms512m -Xmx1g
METABASE_JAVA_OPTS=-Xms256m -Xmx1g
